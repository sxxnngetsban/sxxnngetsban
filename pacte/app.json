{
  "expo": {
    "name": "Pacte",
    "slug": "pacte",
    "version": "1.0.0",
    "scheme": "pacte",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#FDF6E3"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.pacte.mobile"
    },
    "android": {
      "package": "app.pacte.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#FDF6E3",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Pacte utilise la caméra pour scanner l'état de vos objets."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Pacte accède à vos photos pour illustrer vos annonces."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
